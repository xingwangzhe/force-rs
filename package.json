{
  "name": "@xingwangzhe/force-rs",
  "version": "0.1.5",
  "description": "Fast force-directed 3D graph layout powered by Rust + Barnes-Hut octree. Fully compatible with d3-force-3d force model (repulsion, spring with correct degree-biased strength, translational center gravity). Parallelized with Rayon — 47K nodes × 89K edges in ~0.01s/tick on 16 cores.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "author": "xingwangzhe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingwangzhe/force-rs.git"
  },
  "keywords": [
    "force-layout",
    "barnes-hut",
    "d3-force",
    "d3-force-3d",
    "napi-rs",
    "rust",
    "graph-layout",
    "force-directed",
    "3d",
    "octree"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "force-rs.*.node"
  ],
  "napi": {
    "binaryName": "force-rs",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "test": "node --test force.test.mjs",
    "lint": "oxlint",
    "artifacts": "napi artifacts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.3",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2"
  }
}
